# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Supabase or local Docker)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Generate with: npx auth secret
AUTH_SECRET="generate-a-random-secret-with-npx-auth-secret"

# Used by NextAuth for callback URLs
NEXTAUTH_URL="http://localhost:3000"

# Optional — Resend API key for email notifications.
# Without this, notifications log to console instead.
# RESEND_API_KEY=""
EMAIL_FROM="Staffic <notifications@staffic.dev>"
